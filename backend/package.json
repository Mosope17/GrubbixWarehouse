{
  "name": "grubbix-warehouse-backend",
  "private": true,
  "version": "0.0.0",
  "description": "Grubbix Warehouse catalogue and admin API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.2",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.18.8",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
